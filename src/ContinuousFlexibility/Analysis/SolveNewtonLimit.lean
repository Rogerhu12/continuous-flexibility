module

public import ContinuousFlexibility.Analysis.ProjectiveNewtonLimit
public import ContinuousFlexibility.Analysis.ProjectiveNewtonRapidDecay
public import Mathlib.Analysis.LocallyConvex.WithSeminorms
public import Mathlib.Analysis.Normed.Order.Hom.Basic

/-!
# Newton convergence on a complete space defined by seminorms

The nonlinear state space is a closed subspace of a finite product, with its
inherited grading.  The numerical iteration estimates already apply to such
a source.  Completeness and the generating seminorms suffice to close the
same iteration, so a second projective-limit representation of the source
is unnecessary.
-/

@[expose] public section

noncomputable section

set_option backward.isDefEq.respectTransparency false

namespace ContinuousFlexibility.Analysis

open Set Filter
open scoped Topology

section CompleteSource

variable {X : Type*} [UniformSpace X] [AddCommGroup X] [Module ℝ X]
  [IsUniformAddGroup X] [CompleteSpace X]

/-- Summable increments in every defining seminorm give convergence in the
original complete uniform space. -/
theorem solve_tendsto_of_summable_seminorm_increments
    (p : ℕ → Seminorm ℝ X) (hp : WithSeminorms p) {u : ℕ → X}
    (hu : ∀ s, Summable (fun n => p s (u (n + 1) - u n))) :
    ∃ x : X, Tendsto u atTop (𝓝 x) := by
  apply cauchySeq_tendsto_of_complete
  change Cauchy (Filter.map u atTop)
  rw [(SeminormFamily.withSeminorms_iff_uniformSpace_eq_iInf p).mp hp,
    cauchy_iInf_uniformSpace]
  intro s
  letI : SeminormedAddCommGroup X := (p s).toSeminormedAddCommGroup
  apply cauchySeq_of_summable_dist
  have hdist : (fun n => dist (u n) (u (n + 1))) =
      (fun n => p s (u (n + 1) - u n)) := by
    funext n
    rw [dist_comm, dist_eq_norm]
    exact AddGroupSeminormClass.toSeminormedAddCommGroup_norm_eq
      (p s).toAddGroupSeminorm _
  rw [hdist]
  exact hu s

end CompleteSource

/-- The fixed-parameter Nash--Moser conclusion on any complete source whose
topology is generated by the increasing grading.  The residual remains a
literal projective limit, as in the already proved numerical estimates. -/
theorem solve_exists_fixed_branch
    {X : Type*} [UniformSpace X] [AddCommGroup X] [Module ℝ X]
    [IsUniformAddGroup X] [ContinuousSMul ℝ X] [T2Space X] [CompleteSpace X]
    {F : ℕ → Type*}
    [∀ n, NormedAddCommGroup (F n)] [∀ n, NormedSpace ℝ (F n)]
    {f : ∀ n, F (n + 1) →L[ℝ] F n}
    (p : ℕ → Seminorm ℝ X) (hp : Monotone p) (hwp : WithSeminorms p)
    (x₀ : X) (b₀ : ℕ) (ε₀ : ℝ) (hε₀ : 0 < ε₀)
    {U : Set (X × ℝ)}
    (hU : U = {z | p b₀ (z.1 - x₀) < ε₀ ∧ |z.2| < ε₀})
    (R : X × ℝ → ProjectiveLimit F f)
    (V : X × ℝ → ProjectiveLimit F f →ₗ[ℝ] X)
    (Q : X × ℝ →
      ProjectiveLimit F f →ₗ[ℝ] ProjectiveLimit F f →ₗ[ℝ] ProjectiveLimit F f)
    (hzero : R (x₀, 0) = 0)
    (hRight : ∀ z ∈ U, ∀ y, HasProjectiveLineDerivAt (fun x => R (x, z.2))
      (y + Q z (R z) y) z.1 (V z y)) :
    let q := gradedSeminorm F f
    let a := Statements.pairGrading p Statements.realGrading
    Statements.HasSmoothing p → Statements.HasSmoothing q →
    Statements.SmoothTameOn a q U R →
    Statements.SmoothTameOn (Statements.pairGrading a q) p (U ×ˢ univ)
      (fun z : (X × ℝ) × ProjectiveLimit F f => V z.1 z.2) →
    Statements.SmoothTameOn (Statements.pairGrading (Statements.pairGrading a q) q)
      q ((U ×ˢ univ) ×ˢ univ)
      (fun z : ((X × ℝ) × ProjectiveLimit F f) × ProjectiveLimit F f =>
        Q z.1.1 z.1.2 z.2) →
    ∃ SX : ℕ → X →L[ℝ] X,
      ∃ N₀ : ℕ, ∃ q₀ : ℝ, 0 < q₀ ∧ ∃ x : ℝ → X, x 0 = x₀ ∧
        ∀ τ, |τ| < q₀ →
          Tendsto (projectiveSmoothedNewtonIterates R V SX (newtonSmoothingIndex N₀) (x₀, τ))
            atTop (𝓝 (x τ, τ)) ∧ (x τ, τ) ∈ U ∧ R (x τ, τ) = 0 := by
  dsimp only
  intro hSX hSY hR hV hQ
  let q := gradedSeminorm F f
  have hq := gradedSeminorm_monotone F f
  obtain ⟨bMin, hsep⟩ := exists_separating_grade_of_hasSmoothing
    (withSeminorms_graded F f) hq hSY
  obtain ⟨SX, b, l, σ, N₀, q₀, μ, hbMin, hb₀, hN₀, hq₀, hqμ, hμ, hμε₀,
    hiter, D, hD, _, hinc⟩ :=
    exists_projectiveNewton_summable_iterates p hp x₀ b₀ bMin ε₀ hε₀ hU
      R V Q hzero hRight hSX hSY hR hV hQ
  obtain ⟨J, _⟩ := hR
  have hRcont : ContinuousOn R U := by
    have hc : Continuous (fun z : X × ℝ => (z, (Fin.elim0 : Fin 0 → X × ℝ))) :=
      continuous_id.prodMk continuous_const
    exact ((J.continuous 0).comp hc.continuousOn
      (fun z hz => ⟨hz, mem_univ _⟩)).congr (fun z hz => (J.zero z hz).symm)
  let N := newtonSmoothingIndex N₀
  have hpoint (τ : ℝ) (hτ : |τ| < q₀) : ∃ x : X,
      Tendsto (projectiveSmoothedNewtonIterates R V SX N (x₀, τ)) atTop (𝓝 (x, τ)) ∧
        (x, τ) ∈ U ∧ R (x, τ) = 0 := by
    let z := projectiveSmoothedNewtonIterates R V SX N (x₀, τ)
    have hμlt : μ < ε₀ := by linarith only [hμ, hμε₀]
    have hb : b₀ ≤ b + l + l := by omega
    have hsep' : ∀ y, q (b + l) y = 0 → y = 0 := hsep _ (by omega)
    have hsum (s : ℕ) : Summable (fun n => p s ((z (n + 1)).1 - (z n).1)) :=
      Summable.of_nonneg_of_le (fun _ => apply_nonneg _ _)
        (fun n => hinc s n τ hτ) (hD s)
    obtain ⟨x, hx⟩ := solve_tendsto_of_summable_seminorm_increments p hwp
      (u := fun n => (z n).1) hsum
    have hz : Tendsto z atTop (𝓝 (x, τ)) := by
      have hpair : Tendsto (fun n => ((z n).1, τ)) atTop (𝓝 (x, τ)) :=
        hx.prodMk_nhds (tendsto_const_nhds (x := τ))
      apply hpair.congr'
      filter_upwards [] with n
      apply Prod.ext
      · rfl
      · exact (projectiveSmoothedNewtonIterates_parameter R V SX N (x₀, τ) n).symm
    have hclosed (n : ℕ) : p b₀ ((z n).1 - x₀) ≤ μ ∧ |(z n).2| ≤ μ := by
      obtain ⟨_, hparam, hdisp, _⟩ := hiter τ hτ n
      refine ⟨(hp hb _).trans hdisp.le, ?_⟩
      rw [hparam]
      exact hτ.le.trans hqμ
    have hin : (x, τ) ∈ U := by
      rw [hU]
      exact mem_newton_cylinder_of_tendsto (p b₀) (hwp.continuous_seminorm b₀)
        x₀ hz hμlt hclosed
    have hdecay : Tendsto (fun n => q (b + l) (R (z n))) atTop (𝓝 0) :=
      squeeze_zero (fun _ => apply_nonneg _ _) (fun n => (hiter τ hτ n).2.2.2)
        (newton_summable_exponential hN₀ (by positivity : 0 <
          4 * (l : ℝ) + 4 * (σ : ℝ) + 2)).tendsto_atTop_zero
    exact ⟨x, hz, hin, residual_eq_zero_of_tendsto_of_separating_seminorm hRcont hz hin
      (Eventually.of_forall fun n => (hiter τ hτ n).1)
      (q (b + l)) (continuous_gradedSeminorm F f (b + l)) hsep' hdecay⟩
  let x : ℝ → X := fun τ => if hτ : |τ| < q₀ then (hpoint τ hτ).choose else x₀
  have hx (τ : ℝ) (hτ : |τ| < q₀) :
      Tendsto (projectiveSmoothedNewtonIterates R V SX N (x₀, τ)) atTop (𝓝 (x τ, τ)) ∧
        (x τ, τ) ∈ U ∧ R (x τ, τ) = 0 := by
    simpa only [x, dite_eq_left hτ] using (hpoint τ hτ).choose_spec
  have hstat (n : ℕ) : projectiveSmoothedNewtonIterates R V SX N (x₀, 0) n = (x₀, 0) := by
    induction n with
    | zero => rfl
    | succ n ih => simp [projectiveSmoothedNewtonIterates, projectiveSmoothedNewtonStep, ih, hzero]
  have hlim := (hx 0 (by simpa only [abs_zero] using hq₀)).1
  rw [show projectiveSmoothedNewtonIterates R V SX N (x₀, 0) = fun _ => (x₀, 0) from
    funext hstat] at hlim
  have heq : (x 0, (0 : ℝ)) = (x₀, 0) := tendsto_nhds_unique hlim tendsto_const_nhds
  exact ⟨SX, N₀, q₀, hq₀, x, congrArg Prod.fst heq, hx⟩

end ContinuousFlexibility.Analysis
