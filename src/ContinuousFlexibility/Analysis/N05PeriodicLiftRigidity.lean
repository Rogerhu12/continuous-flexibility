import Mathlib.MeasureTheory.Integral.IntervalIntegral.Periodic
import Mathlib.Topology.Instances.AddCircle.DenseSubgroup
import Mathlib.Tactic.Linarith
import Mathlib.Tactic.Ring

/-!
# Rigidity of continuous degree-one periodic lifts

Integrating the periodic displacement over one period identifies any
constant translation increment with its actual translation length.  Two
incommensurable periods then make a continuous displacement constant; odd
symmetry forces that constant to vanish.
-/

noncomputable section

namespace ContinuousFlexibility.Statements

open Set MeasureTheory

theorem n05_lift_translation_increment
    {G : ℝ → ℝ} {P t c : ℝ} (hG : Continuous G) (hP : P ≠ 0)
    (hlift : ∀ x, G (x + P) = G x + P)
    (hshift : ∀ x, G (x + t) = G x + c) : c = t := by
  let F : ℝ → ℝ := fun x => G x - x
  have hF : Continuous F := hG.sub continuous_id
  have hperiod : Function.Periodic F P := by
    intro x
    change G (x + P) - (x + P) = G x - x
    rw [hlift x]
    ring
  have hdiff (x : ℝ) : F (x + t) - F x = c - t := by
    dsimp only [F]
    rw [hshift x]
    ring
  have htranslate : (∫ x in (0 : ℝ)..P, F (x + t)) = ∫ x in (0 : ℝ)..P, F x := by
    rw [intervalIntegral.integral_comp_add_right]
    simpa only [zero_add, add_comm t P] using hperiod.intervalIntegral_add_eq t 0
  have hintZero : (∫ x in (0 : ℝ)..P, F (x + t) - F x) = 0 := by
    have hFt : Continuous (fun x : ℝ => F (x + t)) :=
      hF.comp (continuous_id.add (continuous_const (y := t)))
    rw [intervalIntegral.integral_sub
      (hFt.intervalIntegrable 0 P)
      (hF.intervalIntegrable 0 P), htranslate, sub_self]
  have hintValue : (∫ x in (0 : ℝ)..P, F (x + t) - F x) = P * (c - t) := by
    calc
      _ = ∫ _ in (0 : ℝ)..P, c - t :=
        intervalIntegral.integral_congr (fun x _ => hdiff x)
      _ = _ := by simp only [intervalIntegral.integral_const, sub_zero, smul_eq_mul]
  exact sub_eq_zero.mp ((mul_eq_zero.mp (hintValue.symm.trans hintZero)).resolve_left hP)

/-- A symmetric finite difference of a degree-one periodic lift determines
the length of its half translation. -/
theorem n05_lift_symmetric_difference
    {G : ℝ → ℝ} {P t τ : ℝ} (hG : Continuous G) (hP : P ≠ 0)
    (hlift : ∀ x, G (x + P) = G x + P)
    (hdiff : ∀ x, G (x + t) - G (x - t) = 2 * τ) : τ = t := by
  have hshift (x : ℝ) : G (x + 2 * t) = G x + 2 * τ := by
    have heq := hdiff (x + t)
    have hplus : x + t + t = x + 2 * t := by ring
    rw [hplus, add_sub_cancel_right] at heq
    linarith only [heq]
  have heq := n05_lift_translation_increment hG hP hlift hshift
  linarith only [heq]

/-- A continuous real function with two incommensurable periods is constant.
The density is the actual density of the subgroup generated by its periods. -/
theorem n05_two_periods_constant
    {f : ℝ → ℝ} {P t : ℝ} (hf : Continuous f)
    (hP : Function.Periodic f P) (ht : Function.Periodic f t)
    (hirr : Irrational (t / P)) (x : ℝ) : f x = f 0 := by
  let periods : AddSubgroup ℝ :=
    { carrier := {s | Function.Periodic f s}
      zero_mem' := by intro y; rw [add_zero]
      add_mem' := fun {a b} ha hb => ha.add_period hb
      neg_mem' := fun {a} ha => ha.neg }
  have hsub : AddSubgroup.closure ({t, P} : Set ℝ) ≤ periods :=
    (AddSubgroup.closure_le periods).mpr (pair_subset_iff.mpr ⟨ht, hP⟩)
  have hdense : Dense (periods : Set ℝ) :=
    (dense_addSubgroupClosure_pair_iff.mpr hirr).mono hsub
  exact hdense.induction
    (fun s hs => by
      simpa only [zero_add] using (show Function.Periodic f s from hs) 0)
    (isClosed_eq hf continuous_const) x

theorem n05_odd_lift_eq_identity
    {G : ℝ → ℝ} {P t : ℝ} (hG : Continuous G)
    (hP : ∀ x, G (x + P) = G x + P)
    (ht : ∀ x, G (x + t) = G x + t)
    (hirr : Irrational (t / P)) (hodd : ∀ x, G (-x) = -G x) (x : ℝ) : G x = x := by
  let F : ℝ → ℝ := fun x => G x - x
  have periodic_of_lift {s : ℝ} (hs : ∀ y, G (y + s) = G y + s) :
      Function.Periodic F s := by
    intro y
    change G (y + s) - (y + s) = G y - y
    rw [hs y]
    ring
  have hconstant := n05_two_periods_constant (hG.sub continuous_id)
    (periodic_of_lift hP) (periodic_of_lift ht) hirr x
  have hzero : G 0 = 0 := by
    have heq := hodd 0
    rw [neg_zero] at heq
    linarith only [heq]
  change G x - x = G 0 - 0 at hconstant
  rw [hzero, sub_zero] at hconstant
  exact sub_eq_zero.mp hconstant

end ContinuousFlexibility.Statements
