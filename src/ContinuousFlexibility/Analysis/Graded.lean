module

public import Mathlib.Analysis.LocallyConvex.WithSeminorms
public import Mathlib.Analysis.Normed.Module.Seminorm.Norm
public import Mathlib.Topology.Algebra.Module.ContinuousLinearMap.PiProd
public import Mathlib.Topology.Algebra.Module.ContinuousLinearMap.Restrict
public import Mathlib.Topology.Metrizable.CompletelyMetrizable
public import Mathlib.Topology.UniformSpace.Pi

/-!
# Compatible Banach scales as complete graded Fréchet spaces

Given a countable family of real normed spaces and continuous linear
bonding maps, their compatible projective limit is a concrete linear
subspace of the product. It is closed because each compatibility equation
is a closed equalizer. If the levels are complete, the limit is complete.

The existing product/subspace topology is metrizable and locally convex;
it is generated by the increasing finite maxima of the coordinate norms.
These properties are proved, rather than supplied as fields of a structure.

Instantiating the levels with the manuscript's actual weighted Sobolev
spaces, constructing smoothing operators, and proving tame estimates and
a Nash–Moser iteration are separate obligations.
-/

@[expose] public section

noncomputable section

set_option backward.isDefEq.respectTransparency false

namespace ContinuousFlexibility.Analysis

open Set Topology TopologicalSpace

universe u

variable (E : ℕ → Type u) [∀ n, NormedAddCommGroup (E n)] [∀ n, NormedSpace ℝ (E n)]
variable (bond : ∀ n, E (n + 1) →L[ℝ] E n)

/-- Actual compatible sequences for the adjacent bonding maps. -/
def compatibleSubmodule : Submodule ℝ (∀ n, E n) where
  carrier := {x | ∀ n, bond n (x (n + 1)) = x n}
  zero_mem' := by intro n; simp
  add_mem' := by
    intro x y hx hy n
    simp only [Pi.add_apply, map_add, hx n, hy n]
  smul_mem' := by
    intro c x hx n
    simp only [Pi.smul_apply, map_smul, hx n]

/-- The compatible limit carries the actual product subspace topology and
uniformity, inherited from its realization as a linear subspace. -/
abbrev ProjectiveLimit := compatibleSubmodule E bond

@[simp] theorem mem_compatibleSubmodule (x : ∀ n, E n) :
    x ∈ compatibleSubmodule E bond ↔ ∀ n, bond n (x (n + 1)) = x n := Iff.rfl

theorem isClosed_compatibleSubmodule :
    IsClosed (compatibleSubmodule E bond : Set (∀ n, E n)) := by
  change IsClosed {x : ∀ n, E n | ∀ n, bond n (x (n + 1)) = x n}
  rw [Set.ofPred_forall]
  exact isClosed_iInter fun n => isClosed_eq
    ((bond n).continuous.comp (continuous_apply (n + 1))) (continuous_apply n)

instance projectiveLimit_completeSpace [∀ n, CompleteSpace (E n)] :
    CompleteSpace (ProjectiveLimit E bond) := by
  let : IsClosed (compatibleSubmodule E bond : Set (∀ n, E n)) :=
    isClosed_compatibleSubmodule E bond
  exact inferInstanceAs (CompleteSpace (compatibleSubmodule E bond))

instance projectiveLimit_locallyConvexSpace : LocallyConvexSpace ℝ (ProjectiveLimit E bond) :=
  inferInstanceAs (LocallyConvexSpace ℝ (compatibleSubmodule E bond))

instance projectiveLimit_metrizableSpace : MetrizableSpace (ProjectiveLimit E bond) :=
  TopologicalSpace.MetrizableSpace.subtype (compatibleSubmodule E bond : Set (∀ n, E n))

instance projectiveLimit_completelyMetrizableSpace [∀ n, CompleteSpace (E n)] :
    IsCompletelyMetrizableSpace (ProjectiveLimit E bond) := by
  have : (uniformity (ProjectiveLimit E bond)).IsCountablyGenerated :=
    inferInstanceAs (Filter.IsCountablyGenerated
      (uniformity (compatibleSubmodule E bond : Set (∀ n, E n))))
  exact IsCompletelyMetrizableSpace.of_completeSpace_metrizable

/-- The actual continuous linear coordinate projection. -/
def projectiveCoordinate (n : ℕ) : ProjectiveLimit E bond →L[ℝ] E n :=
  (ContinuousLinearMap.proj n).comp (compatibleSubmodule E bond).subtypeL

@[simp] theorem projectiveCoordinate_apply (n : ℕ) (x : ProjectiveLimit E bond) :
    projectiveCoordinate E bond n x = x.1 n := rfl

theorem projectiveCoordinate_bond (n : ℕ) :
    (bond n).comp (projectiveCoordinate E bond (n + 1)) = projectiveCoordinate E bond n := by
  ext x
  exact x.2 n

/-- Convergence in the actual limit topology is precisely convergence in
each Banach level. -/
theorem tendsto_projectiveLimit_iff {α : Type*} {l : Filter α}
    {f : α → ProjectiveLimit E bond} {x : ProjectiveLimit E bond} :
    Filter.Tendsto f l (𝓝 x) ↔
      ∀ n, Filter.Tendsto (fun a => (f a).1 n) l (𝓝 (x.1 n)) := by
  rw [tendsto_subtype_rng, tendsto_pi_nhds]

/-- Every compatible family of actual continuous linear maps induces an
actual continuous linear map to the projective limit. -/
def projectiveLift {V : Type*} [TopologicalSpace V] [AddCommGroup V] [Module ℝ V]
    (f : ∀ n, V →L[ℝ] E n)
    (hf : ∀ n, (bond n).comp (f (n + 1)) = f n) : V →L[ℝ] ProjectiveLimit E bond :=
  (ContinuousLinearMap.pi f).codRestrict (compatibleSubmodule E bond) (by
    intro v n
    exact DFunLike.congr_fun (hf n) v)

@[simp] theorem projectiveLift_apply {V : Type*} [TopologicalSpace V] [AddCommGroup V]
    [Module ℝ V] (f : ∀ n, V →L[ℝ] E n)
    (hf : ∀ n, (bond n).comp (f (n + 1)) = f n) (v : V) (n : ℕ) :
    (projectiveLift E bond f hf v).1 n = f n v := rfl

theorem projectiveLift_unique {V : Type*} [TopologicalSpace V] [AddCommGroup V] [Module ℝ V]
    (f : ∀ n, V →L[ℝ] E n) (hf : ∀ n, (bond n).comp (f (n + 1)) = f n)
    (g : V →L[ℝ] ProjectiveLimit E bond)
    (hg : ∀ n, (projectiveCoordinate E bond n).comp g = f n) :
    g = projectiveLift E bond f hf := by
  apply ContinuousLinearMap.ext
  intro v
  apply Subtype.ext
  funext n
  exact DFunLike.congr_fun (hg n) v

/-- Coordinate norms on the full product, before restricting to the limit. -/
def productCoordinateSeminorm (n : ℕ) : Seminorm ℝ (∀ n, E n) :=
  (normSeminorm ℝ (E n)).comp (LinearMap.proj n)

theorem withSeminorms_productCoordinate : WithSeminorms (productCoordinateSeminorm E) := by
  change WithSeminorms (fun n => (normSeminorm ℝ (E n)).comp (LinearMap.proj n))
  have hp := withSeminorms_pi (fun n => norm_withSeminorms ℝ (E n))
  have hq := hp.congr_equiv (Equiv.sigmaUnique ℕ (fun _ => Unit)).symm
  convert hq using 1
  funext n
  simp only [Function.comp_def, Equiv.sigmaUnique_symm_apply,
    SeminormFamily.sigma, SeminormFamily.comp]

/-- A coordinate seminorm of the actual compatible sequence space. -/
def coordinateSeminorm (n : ℕ) : Seminorm ℝ (ProjectiveLimit E bond) :=
  (productCoordinateSeminorm E n).comp (compatibleSubmodule E bond).subtype

@[simp] theorem coordinateSeminorm_apply (n : ℕ) (x : ProjectiveLimit E bond) :
    coordinateSeminorm E bond n x = ‖x.1 n‖ := rfl

theorem withSeminorms_coordinate : WithSeminorms (coordinateSeminorm E bond) := by
  exact (Topology.IsInducing.subtypeVal).withSeminorms (f := (compatibleSubmodule E bond).subtype)
    (withSeminorms_productCoordinate E)

/-- The grading is the finite maximum of the first `n+1` coordinate norms. -/
def gradedSeminorm (n : ℕ) : Seminorm ℝ (ProjectiveLimit E bond) :=
  (Finset.Iic n).sup (coordinateSeminorm E bond)

theorem withSeminorms_graded : WithSeminorms (gradedSeminorm E bond) :=
  (withSeminorms_coordinate E bond).partial_sups

theorem gradedSeminorm_monotone : Monotone (gradedSeminorm E bond) := by
  intro m n hmn
  apply Finset.sup_mono
  intro i hi
  exact Finset.mem_Iic.mpr ((Finset.mem_Iic.mp hi).trans hmn)

theorem norm_coordinate_le_graded {i n : ℕ} (hin : i ≤ n) (x : ProjectiveLimit E bond) :
    ‖x.1 i‖ ≤ gradedSeminorm E bond n x := by
  change coordinateSeminorm E bond i x ≤ (Finset.Iic n).sup (coordinateSeminorm E bond) x
  exact Seminorm.le_finset_sup_apply (Finset.mem_Iic.mpr hin)

theorem gradedSeminorm_le_iff (n : ℕ) (x : ProjectiveLimit E bond) {c : ℝ} (hc : 0 ≤ c) :
    gradedSeminorm E bond n x ≤ c ↔ ∀ i ≤ n, ‖x.1 i‖ ≤ c := by
  constructor
  · intro h i hi
    exact (norm_coordinate_le_graded E bond hi x).trans h
  · intro h
    exact Seminorm.finset_sup_apply_le hc (fun i hi => h i (Finset.mem_Iic.mp hi))

theorem gradedSeminorm_exists_norm (n : ℕ) (x : ProjectiveLimit E bond) :
    ∃ i ≤ n, gradedSeminorm E bond n x = ‖x.1 i‖ := by
  obtain ⟨i, hi, heq⟩ := Seminorm.exists_apply_eq_finset_sup
    (coordinateSeminorm E bond) (show (Finset.Iic n).Nonempty from ⟨n, Finset.mem_Iic.mpr le_rfl⟩) x
  exact ⟨i, Finset.mem_Iic.mp hi, heq⟩

theorem continuous_gradedSeminorm (n : ℕ) : Continuous (gradedSeminorm E bond n) :=
  (withSeminorms_graded E bond).continuous_seminorm n

/-- The increasing grading separates points, including when bonding maps
are not injective. -/
theorem gradedSeminorms_separate (x : ProjectiveLimit E bond) :
    (∀ n, gradedSeminorm E bond n x = 0) ↔ x = 0 := by
  constructor
  · intro hx
    apply Subtype.ext
    funext n
    apply norm_eq_zero.mp
    exact le_antisymm ((norm_coordinate_le_graded E bond le_rfl x).trans_eq (hx n))
      (norm_nonneg _)
  · intro hx
    subst x
    intro n
    exact map_zero (gradedSeminorm E bond n)

end ContinuousFlexibility.Analysis
