module

public import ContinuousFlexibility.Statements.MainGeometry
public import Lean.Util.CollectAxioms

/-!
Owner-based audit of every declaration generated by the geometric target
module, including structure constructors and projections. Passing this audit
only validates the declarations of the targets; it proves no target inhabitable.
-/

@[expose] public section

open Lean in
run_cmd do
  let env ← getEnv
  let mut declarations : Nat := 0
  let mut theorems : Nat := 0
  let mut observed : List Name := []
  for (name, info) in env.constants.toList do
    let owned := match env.getModuleIdxFor? name with
      | some idx => env.allImportedModuleNames[idx.toNat]! ==
          `ContinuousFlexibility.Statements.MainGeometry
      | none => false
    if owned then
      declarations := declarations + 1
      match info with
      | .axiomInfo _ => throwError "Target module declares an axiom: {name}"
      | .thmInfo _ => theorems := theorems + 1
      | _ => pure ()
      let axioms ← collectAxioms name
      for ax in axioms do
        unless observed.contains ax do
          observed := ax :: observed
        unless ax == ``propext || ax == ``Classical.choice || ax == ``Quot.sound do
          throwError "Unexpected axiom {ax} in target declaration {name}"
  if declarations == 0 then
    throwError "No target-module declarations were audited"
  logInfo m!"Geometric target declaration audit passed: {declarations} declarations ({theorems} generated theorems); no target existence is proved"
  logInfo m!"Observed transitive axioms: {observed.reverse}"
