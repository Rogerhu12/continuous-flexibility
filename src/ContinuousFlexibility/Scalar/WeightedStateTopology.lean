module

public import ContinuousFlexibility.Statements.ScalarWeighted
public import ContinuousFlexibility.Analysis.TamePairTopology

/-!
# The actual weighted state topology and complete model levels

The frozen Sobolev-model hypotheses make every level a closed subspace of
its physical jet Hilbert space.  The scalar state uses the ordinary nested
product topology, generated by its prescribed sum grading.
-/

@[expose] public section

noncomputable section

namespace ContinuousFlexibility.Statements

open ContinuousFlexibility.Analysis

/-- Install this instance locally when a chain rule requires complete target
levels.  Completeness follows from the existing closed-level hypothesis. -/
theorem SobolevModelData.completeSpace_level_of_isSobolevModel
    {D : ReferenceData} {T : MaterialData} {γ : ℝ} {A : SobolevModelData}
    (hA : IsSobolevModel D T γ A) (s : ℕ) : CompleteSpace (A.level s) :=
  (hA.2.1 s).isComplete.completeSpace_coe

theorem weighted_realGrading_monotone : Monotone realGrading :=
  fun _ _ _ _ => le_rfl

theorem weighted_realGrading_withSeminorms : WithSeminorms realGrading := by
  apply (norm_withSeminorms ℝ ℝ).congr
  · intro n
    exact ⟨{()}, 1, by simp [realGrading]⟩
  · intro u
    exact ⟨{0}, 1, by simp [realGrading]⟩

theorem weighted_scalarHeightGrading_monotone (S : PhysicalSpacesData) :
    Monotone (scalarHeightGrading S) :=
  gradedSeminorm_monotone _ _

theorem weighted_scalarHeightGrading_withSeminorms (S : PhysicalSpacesData) :
    WithSeminorms (scalarHeightGrading S) :=
  withSeminorms_graded _ _

theorem weighted_scalarCommonHeightGrading_monotone (S : PhysicalSpacesData) :
    Monotone (scalarCommonHeightGrading S) :=
  tamePairGrading_monotone (weighted_scalarHeightGrading_monotone S)
    weighted_realGrading_monotone

theorem weighted_scalarCommonHeightGrading_withSeminorms (S : PhysicalSpacesData) :
    WithSeminorms (scalarCommonHeightGrading S) :=
  withSeminorms_pairGrading (weighted_scalarHeightGrading_withSeminorms S)
    weighted_realGrading_withSeminorms

theorem weighted_scalarStateGrading_monotone (S : PhysicalSpacesData) :
    Monotone (scalarStateGrading S) :=
  tamePairGrading_monotone
    (tamePairGrading_monotone
      (tamePairGrading_monotone (weighted_scalarHeightGrading_monotone S)
        (weighted_scalarHeightGrading_monotone S))
      weighted_realGrading_monotone)
    weighted_realGrading_monotone

theorem weighted_scalarStateGrading_withSeminorms (S : PhysicalSpacesData) :
    WithSeminorms (scalarStateGrading S) :=
  withSeminorms_pairGrading
    (withSeminorms_pairGrading
      (withSeminorms_pairGrading (weighted_scalarHeightGrading_withSeminorms S)
        (weighted_scalarHeightGrading_withSeminorms S))
      weighted_realGrading_withSeminorms)
    weighted_realGrading_withSeminorms

end ContinuousFlexibility.Statements
