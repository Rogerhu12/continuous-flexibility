+    (Θ : (ℝ × ℝ) → ℝ → ℝ → ℝ)
+    (hband : ControlledRootBandChartAgreement C K z m rightEnd δ η Θ)
+    (hcoeff : ∀ x ∈ Ioc (0 : ℝ) η, ∀ θ : ℝ,
