import ContinuousFlexibility.Radial.OscillatorClosedGraph

/-!
# Adjoint maximality and kernels of the central Hermite graph

The inner products and coefficients are those of actual Lebesgue L².
The pairing characterization proves both symmetry and maximality of the
adjoint relation, without importing an additional unbounded-operator
interface. The graph is the same closure of genuine finite Hermite
differential pairs used by the inverse construction.

These results support R03.02 and R03.05. They do not identify the graph
with a distribution or Friedrichs domain; those require separate bridges.
-/

noncomputable section

namespace ContinuousFlexibility.Radial

open Real Set Filter MeasureTheory
open scoped Topology RealInnerProductSpace InnerProductSpace

set_option backward.isDefEq.respectTransparency false

/-- Every genuine Hermite eigenpair belongs to the same closed graph. -/
theorem centralClosedGraph_eigenpair {j : ℝ} (hj : 0 < j) (n : ℕ) :
    (hermiteL2Vector hj n, centralSpectralLevel j n • hermiteL2Vector hj n) ∈
      centralClosedGraph hj :=
  (centralFiniteGraph hj).le_topologicalClosure (Submodule.subset_span ⟨n, rfl⟩)

/-- The closed differential-core graph is symmetric for the actual L²
inner product. Both Parseval series use the same real energy levels. -/
theorem centralClosedGraph_symmetric {j : ℝ} (hj : 0 < j)
    (u v x y : HermiteL2) (huv : (u, v) ∈ centralClosedGraph hj)
    (hxy : (x, y) ∈ centralClosedGraph hj) :
    ⟪v, x⟫_ℝ = ⟪u, y⟫_ℝ := by
  have hv := (mem_centralClosedGraph_iff hj u v).mp huv
  have hy := (mem_centralClosedGraph_iff hj x y).mp hxy
  have hleft := hermiteCoefficient_hasSum_mul hj v x
  have hright : HasSum
      (fun n => hermiteCoefficient j v n * hermiteCoefficient j x n) ⟪u, y⟫_ℝ := by
    convert hermiteCoefficient_hasSum_mul hj u y using 1
    funext n
    rw [hv n, hy n]
    ring
  exact hleft.unique hright

/-- Maximality of the actual graph-adjoint relation. The reverse
implication tests every genuine Hermite eigenpair, rather than assuming
that symmetry alone establishes self-adjointness. -/
theorem centralClosedGraph_pairing_iff {j : ℝ} (hj : 0 < j) (x y : HermiteL2) :
    (x, y) ∈ centralClosedGraph hj ↔
      ∀ u v : HermiteL2, (u, v) ∈ centralClosedGraph hj →
        ⟪v, x⟫_ℝ = ⟪u, y⟫_ℝ := by
  constructor
  · intro hxy u v huv
    exact centralClosedGraph_symmetric hj u v x y huv hxy
  · intro h
    apply (mem_centralClosedGraph_iff hj x y).mpr
    intro n
    have hn := h (hermiteL2Vector hj n)
      (centralSpectralLevel j n • hermiteL2Vector hj n)
      (centralClosedGraph_eigenpair hj n)
    rw [real_inner_smul_left, inner_hermiteL2Vector_left,
      inner_hermiteL2Vector_left] at hn
    exact hn.symm

/-- Completeness in the actual product graph norm. -/
theorem centralClosedGraph_completeSpace {j : ℝ} (hj : 0 < j) :
    CompleteSpace (centralClosedGraph hj) :=
  (centralClosedGraph_isClosed hj).isComplete.completeSpace_coe

private theorem coefficient_zero {j : ℝ} (hj : 0 < j) (m : ℕ) :
    hermiteCoefficient j (0 : HermiteL2) m = 0 := by
  simpa only [hermiteCoefficientCLM_apply] using (hermiteCoefficientCLM hj m).map_zero

private theorem coefficient_smul_ground (c : ℝ) (m : ℕ) :
    hermiteCoefficient 2
      (c • hermiteL2Vector (by norm_num : (0 : ℝ) < 2) 0) m =
      c * (if m = 0 then 1 else 0) := by
  have h := (hermiteCoefficientCLM (by norm_num : (0 : ℝ) < 2) m).map_smul c
    (hermiteL2Vector (by norm_num : (0 : ℝ) < 2) 0)
  rw [hermiteCoefficientCLM_apply, hermiteCoefficientCLM_apply,
    hermiteCoefficient_hermiteL2Vector] at h
  simpa only [smul_eq_mul] using h

/-- The complete zero kernel of the same closed mode-two graph is the
line generated by the genuine normalized Gaussian L² vector. -/
theorem centralClosedGraph_two_kernel_iff (u : HermiteL2) :
    (u, 0) ∈ centralClosedGraph (by norm_num : (0 : ℝ) < 2) ↔
      ∃ c : ℝ, u = c • hermiteL2Vector (by norm_num : (0 : ℝ) < 2) 0 := by
  constructor
  · intro hu
    have hrel := (mem_centralClosedGraph_iff (by norm_num : (0 : ℝ) < 2) u 0).mp hu
    refine ⟨hermiteCoefficient 2 u 0, ?_⟩
    apply (hermiteCoefficientTransform (by norm_num : (0 : ℝ) < 2)).injective
    apply lp.ext
    funext m
    rw [hermiteCoefficientTransform_apply, hermiteCoefficientTransform_apply,
      coefficient_smul_ground]
    by_cases hm : m = 0
    · subst m
      simp
    · rw [ite_eq_right hm, mul_zero]
      have hz := hrel m
      rw [coefficient_zero (by norm_num : (0 : ℝ) < 2), centralSpectralLevel_two] at hz
      have hm0 : (m : ℝ) ≠ 0 := by exact_mod_cast hm
      exact (mul_eq_zero.mp hz.symm).resolve_left (mul_ne_zero (by norm_num) hm0)
  · rintro ⟨c, rfl⟩
    apply (mem_centralClosedGraph_iff (by norm_num : (0 : ℝ) < 2) _ _).mpr
    intro m
    rw [coefficient_zero (by norm_num : (0 : ℝ) < 2), coefficient_smul_ground,
      centralSpectralLevel_two]
    by_cases hm : m = 0
    · subst m
      simp
    · simp [hm]

private theorem positive_even_frequency (n : ℕ) (hn : 2 ≤ n) :
    (0 : ℝ) < 2 * (n : ℝ) := by
  have hn' : (2 : ℝ) ≤ n := by exact_mod_cast hn
  linarith

/-- Every other even frequency has trivial kernel in the same actual
closed graph, using the uniform gap for every Hermite coefficient. -/
theorem centralClosedGraph_even_kernel_iff (n : ℕ) (hn : 2 ≤ n) (u : HermiteL2) :
    (u, 0) ∈ centralClosedGraph (positive_even_frequency n hn) ↔ u = 0 := by
  constructor
  · intro hu
    have hrel := (mem_centralClosedGraph_iff (positive_even_frequency n hn) u 0).mp hu
    apply (hermiteCoefficientTransform (positive_even_frequency n hn)).injective
    apply lp.ext
    funext m
    rw [hermiteCoefficientTransform_apply, hermiteCoefficientTransform_apply,
      coefficient_zero (positive_even_frequency n hn)]
    have hz := hrel m
    rw [coefficient_zero (positive_even_frequency n hn)] at hz
    have he : centralSpectralLevel (2 * (n : ℝ)) m ≠ 0 := by
      intro he
      have hgap := centralSpectralLevel_even_gap n m hn
      rw [he, abs_zero] at hgap
      linarith [centralGapDelta_pos]
    exact (mul_eq_zero.mp hz.symm).resolve_left he
  · rintro rfl
    exact (centralClosedGraph (positive_even_frequency n hn)).zero_mem

end ContinuousFlexibility.Radial
