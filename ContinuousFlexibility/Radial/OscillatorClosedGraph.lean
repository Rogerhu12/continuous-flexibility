import ContinuousFlexibility.Radial.HermiteBasis
import ContinuousFlexibility.Radial.CentralSpectralGap

/-!
# Closure of the finite central Hermite differential graph

The core graph is the span of the genuine differential eigenfunction pairs
in real Lebesgue `L² × L²`. Its closure is characterized by the actual
Hermite integral coefficients. Both components are approximated by the
same finite Hermite truncations.

This identifies the closure of this specific core graph. Identification
with the full distribution domain or the Friedrichs realization is a
separate obligation.
-/

noncomputable section

namespace ContinuousFlexibility.Radial

open Real Set Filter MeasureTheory
open scoped Topology RealInnerProductSpace InnerProductSpace

set_option backward.isDefEq.respectTransparency false

/-- An actual continuous linear integral-coordinate functional on `L²`. -/
def hermiteCoefficientCLM {j : ℝ} (hj : 0 < j) (n : ℕ) :
    HermiteL2 →L[ℝ] ℝ :=
  innerSL ℝ (hermiteL2Vector hj n)

@[simp] theorem hermiteCoefficientCLM_apply {j : ℝ} (hj : 0 < j)
    (n : ℕ) (u : HermiteL2) :
    hermiteCoefficientCLM hj n u = hermiteCoefficient j u n :=
  inner_hermiteL2Vector_left hj u n

theorem hermiteCoefficient_continuous {j : ℝ} (hj : 0 < j) (n : ℕ) :
    Continuous (fun u : HermiteL2 => hermiteCoefficient j u n) := by
  have heq : (fun u : HermiteL2 => hermiteCoefficient j u n) =
      (hermiteCoefficientCLM hj n : HermiteL2 → ℝ) := by
    funext u
    exact (hermiteCoefficientCLM_apply hj n u).symm
  rw [heq]
  exact (hermiteCoefficientCLM hj n).continuous

@[simp] theorem hermiteCoefficient_hermiteL2Vector {j : ℝ} (hj : 0 < j)
    (n k : ℕ) :
    hermiteCoefficient j (hermiteL2Vector hj n) k = if k = n then 1 else 0 := by
  rw [← inner_hermiteL2Vector_left hj, hermiteL2Vector_inner]

/-- The finite graph generated by the proved central differential eigenpairs. -/
def centralFiniteGraph {j : ℝ} (hj : 0 < j) :
    Submodule ℝ (HermiteL2 × HermiteL2) :=
  Submodule.span ℝ (Set.range fun n : ℕ =>
    (hermiteL2Vector hj n, centralSpectralLevel j n • hermiteL2Vector hj n))

/-- The actual product-norm closure of the finite Hermite graph. -/
def centralClosedGraph {j : ℝ} (hj : 0 < j) :
    Submodule ℝ (HermiteL2 × HermiteL2) :=
  (centralFiniteGraph hj).topologicalClosure

private def centralCoefficientGraph {j : ℝ} (hj : 0 < j) :
    Submodule ℝ (HermiteL2 × HermiteL2) where
  carrier := {p | ∀ n, hermiteCoefficientCLM hj n p.2 =
    centralSpectralLevel j n * hermiteCoefficientCLM hj n p.1}
  zero_mem' := by
    intro n
    change hermiteCoefficientCLM hj n 0 =
      centralSpectralLevel j n * hermiteCoefficientCLM hj n 0
    rw [map_zero]
    ring
  add_mem' := by
    intro p q hp hq n
    change hermiteCoefficientCLM hj n (p.2 + q.2) =
      centralSpectralLevel j n * hermiteCoefficientCLM hj n (p.1 + q.1)
    rw [map_add, map_add, hp n, hq n]
    ring
  smul_mem' := by
    intro a p hp n
    change hermiteCoefficientCLM hj n (a • p.2) =
      centralSpectralLevel j n * hermiteCoefficientCLM hj n (a • p.1)
    rw [map_smul, map_smul, hp n]
    simp only [smul_eq_mul]
    ring

private theorem isClosed_centralCoefficientGraph {j : ℝ} (hj : 0 < j) :
    IsClosed (centralCoefficientGraph hj : Set (HermiteL2 × HermiteL2)) := by
  change IsClosed {p : HermiteL2 × HermiteL2 | ∀ n,
    hermiteCoefficientCLM hj n p.2 =
      centralSpectralLevel j n * hermiteCoefficientCLM hj n p.1}
  simp only [ofPred_forall]
  apply isClosed_iInter
  intro n
  exact isClosed_eq ((hermiteCoefficientCLM hj n).continuous.comp continuous_snd)
    (continuous_const.mul ((hermiteCoefficientCLM hj n).continuous.comp continuous_fst))

private theorem centralFiniteGraph_le_coefficientGraph {j : ℝ} (hj : 0 < j) :
    centralFiniteGraph hj ≤ centralCoefficientGraph hj := by
  apply Submodule.span_le.mpr
  rintro p ⟨n, rfl⟩ k
  change hermiteCoefficientCLM hj k (centralSpectralLevel j n • hermiteL2Vector hj n) =
    centralSpectralLevel j k * hermiteCoefficientCLM hj k (hermiteL2Vector hj n)
  rw [map_smul]
  simp only [hermiteCoefficientCLM_apply, hermiteCoefficient_hermiteL2Vector,
    smul_eq_mul]
  split_ifs with h
  · subst k
    rfl
  · simp

/-- The closed graph is exactly the coefficient multiplier relation. -/
theorem mem_centralClosedGraph_iff {j : ℝ} (hj : 0 < j) (u v : HermiteL2) :
    (u, v) ∈ centralClosedGraph hj ↔
      ∀ n, hermiteCoefficient j v n =
        centralSpectralLevel j n * hermiteCoefficient j u n := by
  constructor
  · intro huv
    have hle := (centralFiniteGraph hj).topologicalClosure_minimal
      (centralFiniteGraph_le_coefficientGraph hj) (isClosed_centralCoefficientGraph hj)
    have h := hle huv
    intro n
    simpa only [hermiteCoefficientCLM_apply] using h n
  · intro huv
    have hs := (hermiteExpansion_hasSum hj u).prodMk (hermiteExpansion_hasSum hj v)
    have hseries : HasSum (fun n : ℕ => hermiteCoefficient j u n •
        (hermiteL2Vector hj n, centralSpectralLevel j n • hermiteL2Vector hj n)) (u, v) := by
      convert hs using 1
      funext n
      simp only [Prod.smul_mk, smul_smul, huv n]
      congr 1
      rw [mul_comm]
    change (u, v) ∈ closure (centralFiniteGraph hj : Set (HermiteL2 × HermiteL2))
    apply mem_closure_of_tendsto hseries
    apply Eventually.of_forall
    intro s
    exact (centralFiniteGraph hj).sum_mem fun n hn =>
      (centralFiniteGraph hj).smul_mem _ (Submodule.subset_span ⟨n, rfl⟩)

theorem centralClosedGraph_isClosed {j : ℝ} (hj : 0 < j) :
    IsClosed (centralClosedGraph hj : Set (HermiteL2 × HermiteL2)) :=
  (centralFiniteGraph hj).isClosed_topologicalClosure

/-- A fixed first component has exactly one possible second component. -/
theorem centralClosedGraph_unique {j : ℝ} (hj : 0 < j) (u v w : HermiteL2)
    (hv : (u, v) ∈ centralClosedGraph hj) (hw : (u, w) ∈ centralClosedGraph hj) :
    v = w := by
  apply (hermiteCoefficientTransform hj).injective
  apply lp.ext
  funext n
  simp only [hermiteCoefficientTransform_apply,
    (mem_centralClosedGraph_iff hj u v).mp hv n,
    (mem_centralClosedGraph_iff hj u w).mp hw n]

/-- The spectral graph domain is characterized by square-summability of
the energy-weighted actual Hermite coefficients. -/
theorem centralClosedGraph_domain_iff {j : ℝ} (hj : 0 < j) (u : HermiteL2) :
    (∃ v : HermiteL2, (u, v) ∈ centralClosedGraph hj) ↔
      Memℓp (fun n : ℕ => centralSpectralLevel j n * hermiteCoefficient j u n) 2 := by
  constructor
  · rintro ⟨v, hv⟩
    have heq : (fun n : ℕ => centralSpectralLevel j n * hermiteCoefficient j u n) =
        (hermiteCoefficientTransform hj v : ℕ → ℝ) := by
      funext n
      rw [hermiteCoefficientTransform_apply, (mem_centralClosedGraph_iff hj u v).mp hv n]
    rw [heq]
    exact lp.memℓp _
  · intro hu
    let c : lp (fun _ : ℕ => ℝ) 2 := ⟨_, hu⟩
    refine ⟨(hermiteCoefficientTransform hj).symm c, ?_⟩
    apply (mem_centralClosedGraph_iff hj _ _).mpr
    intro n
    rw [← hermiteCoefficientTransform_apply hj,
      (hermiteCoefficientTransform hj).apply_symm_apply]

/-- The domain contains the actual finite Hermite span. -/
theorem centralFiniteGraph_domain_span {j : ℝ} (hj : 0 < j) :
    (centralFiniteGraph hj).map (LinearMap.fst ℝ HermiteL2 HermiteL2) =
      Submodule.span ℝ (Set.range (hermiteL2Vector hj)) := by
  rw [centralFiniteGraph, Submodule.map_span]
  congr 1
  ext u
  simp only [Set.mem_image, Set.mem_range, LinearMap.fst_apply, exists_exists_eq_and]

/-- The first projection of the genuine closed graph is dense in `L²`. -/
theorem centralClosedGraph_domain_dense {j : ℝ} (hj : 0 < j) :
    ((centralClosedGraph hj).map (LinearMap.fst ℝ HermiteL2 HermiteL2)).topologicalClosure = ⊤ := by
  apply top_unique
  rw [← hermiteL2Vector_dense_span hj, ← centralFiniteGraph_domain_span hj]
  apply Submodule.topologicalClosure_mono
  apply Submodule.map_mono
  exact (centralFiniteGraph hj).le_topologicalClosure

end ContinuousFlexibility.Radial
